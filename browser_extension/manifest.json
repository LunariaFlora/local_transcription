{
  "manifest_version": 3,
  "name": "音频转写工作台 YouTube 导入",
  "version": "1.0.1",
  "description": "从 YouTube 页面收集视频链接并导入本地音频转写工作台。",
  "action": {
    "default_title": "导入到音频转写工作台",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtu.be/*",
    "http://127.0.0.1:8765/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
